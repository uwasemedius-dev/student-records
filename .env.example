# Copy this file to ".env" (remove ".example") and paste your real MongoDB Atlas connection string below.
# Get it from: Atlas dashboard -> your Cluster -> "Connect" -> "Drivers" -> copy the string
# It looks like: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studentDB?retryWrites=true&w=majority

MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/studentDB?retryWrites=true&w=majority
PORT=3000
