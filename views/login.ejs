<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bugema University - Student Records</title>
  <style>
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Segoe UI", Arial, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #12305a;
      background-image:
        linear-gradient(rgba(10, 30, 60, 0.45), rgba(10, 30, 60, 0.45)),
        url("/images/bugema-science-complex.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }
    .login-card {
      width: 100%;
      max-width: 400px;
      margin: 20px;
      padding: 34px 30px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
      text-align: center;
    }
    .login-card h1 { margin: 0 0 4px; font-size: 22px; color: #12305a; }
    .login-card p.sub { margin: 0 0 22px; color: #555; font-size: 14px; }
    .error {
      background: #fde8e8; color: #b42318;
      padding: 9px; border-radius: 8px; margin-bottom: 14px; font-size: 14px;
    }
    input {
      width: 100%; padding: 12px; margin-bottom: 14px;
      border: 1px solid #c8d0dc; border-radius: 8px; font-size: 15px;
    }
    input:focus { outline: none; border-color: #1f5fbf; box-shadow: 0 0 0 3px rgba(31, 95, 191, 0.2); }
    button {
      width: 100%; padding: 12px; border: 0; border-radius: 8px;
      background: #1f5fbf; color: #fff; font-size: 16px; cursor: pointer;
    }
    button:hover { background: #174a96; }
    .footer { margin-top: 18px; font-size: 12px; color: #777; }
  </style>
</head>
<body>
  <div class="login-card">
    <h1>Bugema University</h1>
    <p class="sub">Student Records System</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <input type="text" name="username" placeholder="Username" required autofocus>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Login</button>
    </form>

    <div class="footer">Admin, teachers and students sign in here</div>
  </div>
</body>
</html>