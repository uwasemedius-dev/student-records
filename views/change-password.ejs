<%- include('partials/header') %>

<h1>Change Password</h1>
<% if (forced) { %>
  <p class="alert">You are using a temporary password. Please choose your own to continue.</p>
<% } %>
<% if (error) { %><p style="color:#ff8a80;"><%= error %></p><% } %>
<% if (success) { %><p style="color:#a5d6a7;"><%= success %></p><% } %>

<form method="POST" action="/account">
  <p><input type="password" name="current" placeholder="Current password" required></p>
  <p><input type="password" name="newPassword" placeholder="New password (min 8 characters)" required></p>
  <p><input type="password" name="confirm" placeholder="Confirm new password" required></p>
  <button type="submit" class="btn">Update Password</button>
</form>

<% if (!forced) { %>
  <p><a href="/" style="color:#ffd54f;">&laquo; Back</a></p>
<% } %>

<%- include('partials/footer') %>