<%- include('partials/header') %>

<h1>Manage Users</h1>
<p>
  <a href="/users/new" class="btn btn-small">+ Create User</a>
  <a href="/students" style="color:#ffd54f; margin-left:12px;">&laquo; Back to students</a>
</p>

<% if (success) { %><p class="alert alert-success"><%= success %></p><% } %>
<% if (error) { %><p style="color:#ff8a80;"><%= error %></p><% } %>

<table class="data-table">
  <thead><tr><th>Username</th><th>Role</th><th>Linked student</th><th>Must change password</th><th>Actions</th></tr></thead>
  <tbody>
    <% users.forEach(function(u) { %>
    <tr>
      <td><%= u.username %></td>
      <td><%= u.role %></td>
      <td><%= u.studentRef ? (u.studentRef.studentId + ' - ' + u.studentRef.firstName + ' ' + u.studentRef.lastName) : '-' %></td>
      <td><%= u.mustChangePassword ? 'Yes' : 'No' %></td>
      <td class="actions">
        <a href="/users/<%= u._id %>/edit" class="btn btn-small btn-edit">Edit / Reset</a>
        <% if (String(u._id) !== String(currentUser.id)) { %>
        <form action="/users/<%= u._id %>?_method=DELETE" method="POST" style="display:inline"
              data-name="<%= u.username %>"
              onsubmit="return confirm('Delete user ' + this.dataset.name + '?');">
          <button type="submit" class="btn btn-small btn-delete">Delete</button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/footer') %>